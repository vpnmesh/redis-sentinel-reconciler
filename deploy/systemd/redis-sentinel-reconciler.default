# /etc/default/redis-sentinel-reconciler
# Read by the process (--config). Not a systemd EnvironmentFile:
# $ # space and quotes in passwords stay literal. Quote values with spaces.
#
# Flag, env, and this file are the same knobs:
#   --sentinel-addr  =  SENTINEL_ADDR  =  RSR_SENTINEL_ADDR
# SENTINEL_ADDR and REDIS_ADDRS are required (empty = process will not start).
# Leave APPLY=false until you have watched ticks. Extra knobs: reconciler -h

# Sentinel on this host, host:26379. TLS: DNS name on the certificate, not 127.0.0.1.
# SENTINEL_ADDR=db-n1.example.com:26379
SENTINEL_ADDR=

MASTER_NAME=mymaster

# Every Redis/Valkey data node that can become master, port 6379 (not Sentinel 26379).
# List the whole cluster, not only this host.
# REDIS_ADDRS=db-n1.example.com:6379,db-n2.example.com:6379,db-n3.example.com:6379
REDIS_ADDRS=

APPLY=false
METRICS_ADDR=127.0.0.1:9123

# REDIS_USERNAME=rsr
# REDIS_PASSWORD="p$a#ss word"
# SENTINEL_USERNAME=rsr
# SENTINEL_PASSWORD=
# If Sentinel→Redis ACL is not the probe user:
# SENTINEL_REDIS_USERNAME=sentinel
# SENTINEL_REDIS_PASSWORD=

# TLS=true
# TLS_CA_FILE=/etc/redis/ca.pem
# TLS_SERVER_NAME is only for IP dials.
# TLS_SKIP_VERIFY=false
# TLS_CERT=/etc/redis/client.pem
# TLS_KEY=/etc/redis/client.key
