[Unit]
Description=Redis Sentinel Reconciler (local sidecar)
Documentation=https://github.com/vpnmesh/redis-sentinel-reconciler
After=network-online.target redis-sentinel.service
Wants=network-online.target

[Service]
Type=simple
User=redis
Group=redis
# Parse KEY=VALUE ourselves (--config). systemd EnvironmentFile expands $ and
# treats # as a comment; a Vault password can then drop the whole file.
# Missing/unreadable config is a hard fail (status=2), not a flagless start.
ExecStart=/usr/bin/reconciler --config /etc/default/redis-sentinel-reconciler --local-sentinel
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
