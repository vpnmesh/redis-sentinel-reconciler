{
  "title": "Redis Sentinel Reconciler",
  "uid": "rsr-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "type": "stat",
      "title": "Last tick",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "redis_sentinel_reconciler_diverged", "legendFormat": "diverged" },
        { "expr": "redis_sentinel_reconciler_would_heal", "legendFormat": "would_heal" },
        { "expr": "redis_sentinel_reconciler_writable_masters", "legendFormat": "writable_masters" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Diverge / heal (rate of ticks)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "increase(redis_sentinel_reconciler_diverge_total[5m])", "legendFormat": "diverge_total" },
        { "expr": "increase(redis_sentinel_reconciler_heal_ok_total[5m])", "legendFormat": "heal_ok_total" },
        { "expr": "increase(redis_sentinel_reconciler_heal_fail_total[5m])", "legendFormat": "heal_fail_total" },
        { "expr": "increase(redis_sentinel_reconciler_would_heal_total[5m])", "legendFormat": "would_heal_total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Safety ALERTs (rate of ticks)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "increase(redis_sentinel_reconciler_alert_dual_master_total[5m])", "legendFormat": "dual_master" },
        { "expr": "increase(redis_sentinel_reconciler_alert_no_writable_total[5m])", "legendFormat": "no_writable" },
        { "expr": "increase(redis_sentinel_reconciler_alert_equal_epoch_trap_total[5m])", "legendFormat": "equal_epoch_trap" },
        { "expr": "increase(redis_sentinel_reconciler_apply_refused_total[5m])", "legendFormat": "apply_refused" }
      ]
    }
  ]
}
