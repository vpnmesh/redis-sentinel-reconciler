        { "expr": "increase(redis_sentinel_reconciler_alert_dual_master[5m])", "legendFormat": "dual_master" },
        { "expr": "increase(redis_sentinel_reconciler_alert_no_writable[5m])", "legendFormat": "no_writable" },
        { "expr": "increase(redis_sentinel_reconciler_alert_equal_epoch_trap[5m])", "legendFormat": "equal_epoch_trap" },
